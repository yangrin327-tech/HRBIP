# Optional local settings. No external AI credentials are required.
HOST=127.0.0.1
PORT=4173
DATA_DIR=.data
# Default: account-free, memory-only processing. No database credentials needed.
HRBIP_ACCOUNTS_ENABLED=false
# Set a stable absolute origin + HTTPS before any deployment.
APP_ORIGIN=http://127.0.0.1:4173
COOKIE_SECURE=false
# Public hosting: HTTPS origin. PUBLIC_DEMO=true always disables accounts/storage.
PUBLIC_DEMO=false
# Set only to the trusted reverse-proxy hop count for the chosen host.
TRUST_PROXY_HOPS=0

# Legacy local account mode only: dedicated PostgreSQL connection, never a VITE_ variable.
# Supabase transaction pooler: append sslmode=verify-full&sslrootcert=server/certs/supabase-prod-ca-2021.crt
# DATABASE_URL=
# Optionally omit the password from DATABASE_URL and set it separately.
# PGPASSWORD=
# On Vercel, APP_ORIGIN may be omitted to use its trusted production-domain metadata.

