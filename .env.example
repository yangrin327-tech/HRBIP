# Optional local settings. No external AI credentials are required.
HOST=127.0.0.1
PORT=4173
DATA_DIR=.data
# Set a stable absolute origin + HTTPS before any deployment.
APP_ORIGIN=http://127.0.0.1:4173
COOKIE_SECURE=false
# Public hosting: HTTPS origin, secure cookies, dedicated PostgreSQL or persistent storage.
PUBLIC_DEMO=false
# Set only to the trusted reverse-proxy hop count for the chosen host.
TRUST_PROXY_HOPS=0

# Dedicated HRBIP PostgreSQL server connection, never a VITE_ variable.
# Supabase: transaction pooler URL with TLS (sslmode=verify-full).
# DATABASE_URL=

